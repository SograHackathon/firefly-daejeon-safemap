# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx           # ⚠️ 서버 전용

# Kakao
NEXT_PUBLIC_KAKAO_MAP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # JavaScript 키 (도메인 등록 필요)
KAKAO_REST_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx              # REST 키 (백엔드 전용)

# 공공데이터포털
PUBLIC_DATA_API_KEY=xxxxxxxxxxxxxxxxx                # Decoding 키
PUBLIC_DATA_API_KEY_ENCODED=xxxxxxxxxxxxxxxxx        # Encoding 키 (폴백)

# KOROAD 보행자 사고 다발지역
KOROAD_AUTH_KEY=xxxxxxxxxxxxxxxxx

# Tmap 보행자 라우팅
TMAP_APP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OSRM (Tmap 폴백)
OSRM_URL=https://router.project-osrm.org
